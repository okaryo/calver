{
  "name": "calver",
  "version": "1.1.1",
  "private": true,
  "description": "GitHub Action to calculate the next Calendar Versioning tag.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build lib/index.js -o dist --license licenses.txt",
    "check": "biome check --write .",
    "check:format": "biome format --write .",
    "check:ci": "biome ci .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  }
}
